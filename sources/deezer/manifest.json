{
  "name": "deezer",
  "displayName": "Deezer",
  "version": "1.3.11",
  "description": "Deezer metadata and lossless Hi-Res downloads, with audio quality measured from each downloaded file and complete release metadata.",
  "homepage": "https://github.com/zarzet/SpotiFLAC-Mobile",
  "type": [
    "metadata_provider",
    "download_provider"
  ],
  "minAppVersion": "4.9.1",
  "requiredRuntimeFeatures": [
    "signedSession@1",
    "sessionGrant@1",
    "patternedFileTransform@1",
    "preparedContext@1"
  ],
  "signedSession": {
    "namespace": "zarz-v2",
    "baseUrl": "https://api.zarz.moe/v2",
    "appVersion": "deezer@1.3.5",
    "platform": "extension",
    "schemeLabel": "ZARZ-HMAC-V1",
    "headerPrefix": "X-Zarz-",
    "timeWindowSeconds": 300,
    "endpoints": {
      "bootstrap": "/bootstrap",
      "challenge": "/challenge",
      "exchange": "/session/exchange",
      "refresh": "/session/refresh"
    }
  },
  "permissions": {
    "network": [
      "api.zarz.moe",
      "dl.musicdl.me",
      "api.deezer.com",
      "www.deezer.com",
      "deezer.page.link",
      "link.deezer.com",
      "*.dzcdn.net"
    ],
    "storage": true,
    "file": true
  },
  "qualityOptions": [
    {
      "id": "flac",
      "label": "FLAC / Hi-Res",
      "description": "Best available lossless audio, up to 24-bit/192 kHz on supported tracks. Actual resolution varies by source."
    }
  ],
  "searchBehavior": {
    "enabled": true,
    "primary": true,
    "placeholder": "Search Deezer...",
    "thumbnailRatio": "square",
    "filters": [
      {
        "id": "track",
        "label": "Songs",
        "icon": "music"
      },
      {
        "id": "album",
        "label": "Albums",
        "icon": "album"
      },
      {
        "id": "artist",
        "label": "Artists",
        "icon": "artist"
      },
      {
        "id": "playlist",
        "label": "Playlists",
        "icon": "playlist"
      }
    ]
  },
  "urlHandler": {
    "enabled": true,
    "patterns": [
      "deezer.com",
      "www.deezer.com",
      "deezer.page.link",
      "link.deezer.com",
      "deezer:"
    ]
  },
  "capabilities": {
    "downloadFallbackTier": "lossless",
    "networkTimeoutSeconds": 15,
    "relatedTracks": true,
    "shareUrlTemplates": {
      "album": "https://www.deezer.com/album/{id}",
      "artist": "https://www.deezer.com/artist/{id}"
    }
  },
  "serviceHealth": [
    {
      "id": "zarz-api",
      "label": "Zarz API",
      "url": "https://api.zarz.moe/v1/health",
      "method": "GET",
      "serviceKey": "deezer",
      "timeoutMs": 4000,
      "cacheTtlSeconds": 60,
      "required": true
    }
  ],
  "settings": [
    {
      "key": "apiBaseUrl",
      "label": "Resolver API URL",
      "type": "string",
      "default": "https://api.zarz.moe",
      "description": "Base URL for the Deezer resolver API."
    }
  ]
}
