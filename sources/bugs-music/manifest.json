{
  "name": "bugs-music",
  "displayName": "Bugs Music",
  "version": "2.0.7",
  "description": "Bugs Music metadata, artist catalogs, realtime/daily/weekly charts, genre charts, Music PD albums, and URL imports",
  "author": "ldw0403-netizen",
  "homepage": "https://github.com/ldw0403-netizen/K-Music",
  "icon": "icon.png",
  "permissions": {
    "network": [
      "music.bugs.co.kr",
      "image.bugsm.co.kr"
    ],
    "storage": false,
    "file": false
  },
  "type": [
    "metadata_provider"
  ],
  "minAppVersion": "3.0.1",
  "capabilities": {
    "homeFeed": true,
    "relatedTracks": true
  },
  "searchBehavior": {
    "enabled": true,
    "primary": false,
    "placeholder": "벅스뮤직 검색...",
    "thumbnailRatio": "square"
  },
  "urlHandler": {
    "enabled": true,
    "patterns": [
      "https://music.bugs.co.kr/track/",
      "https://music.bugs.co.kr/album/",
      "https://music.bugs.co.kr/artist/",
      "https://music.bugs.co.kr/musicpd/albumview/",
      "https://m.bugs.co.kr/track/",
      "https://m.bugs.co.kr/album/",
      "https://m.bugs.co.kr/artist/"
    ]
  },
  "skipMetadataEnrichment": false,
  "skipBuiltInFallback": false
}
